# Copy this file to `.env` (same folder) and replace the placeholders.
# `.env` is git-ignored. NEVER commit real credentials or show them on screen.

# --- Django ---
# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=replace-me-with-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# --- SMS Gateway for Android (https://sms-gate.app) ---
# Cloud mode (works from anywhere, phone needs internet):
SMSGATE_URL=https://api.sms-gate.app/3rdparty/v1
# Local mode (computer and phone on the same Wi-Fi) - use the IP shown in the app:
# SMSGATE_URL=http://192.168.1.50:8080

# Username and password shown in the app (Cloud Server or Local Server section)
SMSGATE_USERNAME=your_username_here
SMSGATE_PASSWORD=your_password_here

# --- Optional ---
# SIM slot (1, 2 or 3) on dual-SIM phones; leave empty for the default SIM
SMSGATE_SIM_NUMBER=
# Seconds before a gateway request is treated as a network timeout
SMSGATE_TIMEOUT=15
# Country used to read local numbers such as 09171234567 (ISO code)
SMS_DEFAULT_REGION=PH
TIME_ZONE=Asia/Manila
